#!/usr/bin/env bash
# pre-commit — Git pre-commit hook for Hisaab
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or use: make install-hooks
#
# Runs fast local checks before every commit.
# These are a SUBSET of CI — CI is the authoritative gate.
# These catch the most obvious issues instantly.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

FAIL=0

header() { echo -e "\n${YELLOW}▶ $1${NC}"; }
ok()     { echo -e "  ${GREEN}✓${NC} $1"; }
fail()   { echo -e "  ${RED}✗${NC} $1"; FAIL=1; }
warn()   { echo -e "  ${YELLOW}⚠${NC} $1"; }

echo -e "${YELLOW}═══ Hisaab pre-commit ═══${NC}"

# ─── 1. No float in money code ────────────────────────────────────────────────
header "Float check (monetary code)"
FLOAT_FOUND=$(git diff --cached --name-only | \
  grep -E '^internal/(ledger|settlement|recon)/.*\.go$' | \
  xargs -r grep -n 'float32\|float64' 2>/dev/null | \
  grep -v '_test.go' | \
  grep -v '// RAMP-ONLY' || true)

if [ -n "$FLOAT_FOUND" ]; then
  fail "float32/float64 found in monetary code:"
  echo "$FLOAT_FOUND" | while read -r line; do echo "    $line"; done
else
  ok "No floats in monetary code"
fi

# ─── 2. No SQL string formatting ──────────────────────────────────────────────
header "SQL injection check"
SQL_FOUND=$(git diff --cached --name-only | \
  grep '\.go$' | \
  xargs -r grep -n 'fmt\.Sprintf.*\(SELECT\|INSERT\|UPDATE\|DELETE\)' 2>/dev/null || true)

if [ -n "$SQL_FOUND" ]; then
  fail "SQL string formatting detected (injection risk):"
  echo "$SQL_FOUND" | while read -r line; do echo "    $line"; done
else
  ok "No SQL string formatting"
fi

# ─── 3. No secrets ────────────────────────────────────────────────────────────
header "Secret patterns"
SECRET_FOUND=$(git diff --cached --name-only | \
  xargs -r grep -n \
    -e 'password\s*=\s*"[^"]\+' \
    -e 'secret\s*=\s*"[^"]\+' \
    -e 'api_key\s*=\s*"[^"]\+' \
    -e 'sk-[a-zA-Z0-9]\{20,\}' \
    -e 'ghp_[a-zA-Z0-9]\{36\}' \
    2>/dev/null | \
  grep -v '_test.go\|// SYNTHETIC\|// MOCK\|testdata' || true)

if [ -n "$SECRET_FOUND" ]; then
  fail "Possible secrets in staged files:"
  echo "$SECRET_FOUND" | while read -r line; do echo "    $line"; done
else
  ok "No secret patterns"
fi

# ─── 4. No direct time.Now() in settlement code ───────────────────────────────
header "Clock discipline"
TIMENOW_FOUND=$(git diff --cached --name-only | \
  grep -E '^internal/(settlement|ledger)/.*\.go$' | \
  xargs -r grep -n 'time\.Now()' 2>/dev/null | \
  grep -v '_test.go\|// RAMP-ONLY' || true)

if [ -n "$TIMENOW_FOUND" ]; then
  fail "Direct time.Now() in settlement/ledger (use injectable clock):"
  echo "$TIMENOW_FOUND" | while read -r line; do echo "    $line"; done
else
  ok "Clock discipline OK"
fi

# ─── 5. No TODO stubs in non-test, non-ramp code ─────────────────────────────
header "Stub check"
TODO_FOUND=$(git diff --cached --name-only | \
  grep '\.go$' | \
  xargs -r grep -n '// TODO:\|panic("not implemented")' 2>/dev/null | \
  grep -v '_test.go\|// RAMP-ONLY' || true)

if [ -n "$TODO_FOUND" ]; then
  fail "Unimplemented stubs in production code:"
  echo "$TODO_FOUND" | while read -r line; do echo "    $line"; done
  echo "  → If this is Week 0 ramp code, add '// RAMP-ONLY' comment."
else
  ok "No stubs in production code"
fi

# ─── 6. go fmt check ─────────────────────────────────────────────────────────
header "go fmt"
GO_FILES=$(git diff --cached --name-only | grep '\.go$' || true)
if [ -n "$GO_FILES" ]; then
  UNFMT=$(gofmt -l $GO_FILES 2>/dev/null || true)
  if [ -n "$UNFMT" ]; then
    fail "Unformatted Go files:"
    echo "$UNFMT" | while read -r f; do echo "    $f"; done
    echo "  → Run: gofmt -w $UNFMT"
  else
    ok "All Go files formatted"
  fi
else
  ok "No Go files staged"
fi

# ─── 7. govet on staged Go files ─────────────────────────────────────────────
header "go vet"
if [ -n "$GO_FILES" ]; then
  if go vet ./... 2>&1 | grep -v "^#" | head -20; then
    ok "go vet passed"
  else
    fail "go vet found issues (see above)"
  fi
fi

# ─── 8. Real data check on test fixtures ─────────────────────────────────────
header "Synthetic data check"
FIXTURE_FILES=$(git diff --cached --name-only | grep -E '^(tests|spec)/' || true)
if [ -n "$FIXTURE_FILES" ]; then
  python3 scripts/check_real_data.py 2>&1 | tail -5
  if [ "${PIPESTATUS[0]}" != "0" ]; then
    fail "Real financial data detected in test fixtures"
  else
    ok "Synthetic data check passed"
  fi
else
  ok "No fixture files staged"
fi

# ─── 9. Migration files: require goose comment ────────────────────────────────
header "Migration format"
MIGRATION_FILES=$(git diff --cached --name-only | grep '^db/migrations/' || true)
for f in $MIGRATION_FILES; do
  if ! grep -q "-- goose Up" "$f" 2>/dev/null; then
    fail "$f missing '-- goose Up' marker"
  fi
  if ! grep -q "-- goose Down" "$f" 2>/dev/null; then
    warn "$f missing '-- goose Down' (rollback not defined)"
  fi
done
if [ -z "$MIGRATION_FILES" ]; then
  ok "No migration files staged"
fi

# ─── 10. BRD citation check on scenario tests ────────────────────────────────
header "Spec citation check"
SCENARIO_FILES=$(git diff --cached --name-only | grep '^tests/scenarios/' || true)
for f in $SCENARIO_FILES; do
  if ! grep -q "BRD §\|BRD Section\|Spec version:" "$f" 2>/dev/null; then
    fail "$f: missing BRD citation comment. See docs/ARCHITECTURE.md"
  fi
done
if [ -z "$SCENARIO_FILES" ]; then
  ok "No scenario files staged"
fi

# ─── 11. Console TypeScript check ─────────────────────────────────────────────
header "Console TypeScript check"
CONSOLE_FILES=$(git diff --cached --name-only | grep '^console/' || true)
if [ -n "$CONSOLE_FILES" ]; then
  if (cd console && npm run type-check >/dev/null 2>&1); then
    ok "console type-check passed"
  else
    fail "console tsc --noEmit failed"
  fi
else
  ok "No console files staged"
fi

# ─── Result ───────────────────────────────────────────────────────────────────
echo ""
if [ "$FAIL" -eq 1 ]; then
  echo -e "${RED}═══ pre-commit FAILED — fix issues before committing ═══${NC}"
  echo "    To bypass in emergencies: git commit --no-verify (requires justification in commit message)"
  exit 1
else
  echo -e "${GREEN}═══ pre-commit PASSED ═══${NC}"
  exit 0
fi
