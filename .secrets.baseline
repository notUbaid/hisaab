version: "1.0.0"

# detect-secrets baseline
# Run to update: detect-secrets scan > .secrets.baseline
# Run to audit:  detect-secrets audit .secrets.baseline

# Plugins enabled
plugins_used:
  - name: ArtifactoryDetector
  - name: AWSKeyDetector
  - name: AzureStorageKeyDetector
  - name: BasicAuthDetector
  - name: CloudantDetector
  - name: DiscordBotTokenDetector
  - name: GitHubTokenDetector
  - name: HexHighEntropyString
    limit: 3.0
  - name: IbmCloudIamDetector
  - name: IbmCosHmacDetector
  - name: JwtTokenDetector
  - name: KeywordDetector
    keyword_exclude: "SYNTHETIC|MOCK|FAKE|example|test_|_test|placeholder"
  - name: MailchimpDetector
  - name: NpmDetector
  - name: PrivateKeyDetector
  - name: SendGridDetector
  - name: SlackDetector
  - name: SoftlayerDetector
  - name: SquareOAuthDetector
  - name: StripeDetector
  - name: TwilioKeyDetector

# These paths are checked but results filtered
exclude:
  files:
    - .git/.*
    - \.secrets\.baseline$
    - tests/.*\.go$     # synthetic test data
    - spec/.*\.yaml$    # synthetic spec data
  lines:
    - "# SYNTHETIC"
    - "// SYNTHETIC"
    - "RAMP-ONLY"

results: {}
